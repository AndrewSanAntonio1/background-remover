# Copy to .env.local and adjust.

# Base URL of the API. Leave empty to use the Vite dev proxy defined in
# vite.config.js, which forwards /api -> http://localhost:8000 (the FastAPI
# service in ./backend) and strips the /api prefix.
VITE_API_BASE_URL=

# "true"  -> simulate the background-removal call locally, so the whole UI
#            flow works without running the backend.
# "false" -> send real requests to POST /remove-background.
VITE_USE_MOCK_API=true
